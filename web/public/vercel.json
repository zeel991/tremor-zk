{
  "rewrites": [
    {
      "source": "/((?!assets/|circuits/|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/circuits/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "has": [
        {
          "type": "host",
          "value": "tremor.in"
        }
      ],
      "destination": "https://app.tremor.in/",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [
        {
          "type": "host",
          "value": "www.tremor.in"
        }
      ],
      "destination": "https://app.tremor.in/",
      "permanent": false
    }
  ]
}